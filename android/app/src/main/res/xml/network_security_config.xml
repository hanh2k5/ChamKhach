<?xml version="1.0" encoding="utf-8"?>
<!--
    Cho phép HTTP cleartext với 10.0.2.2 (emulator host) và 192.168.x.x (LAN test).
    Production deployment nên dùng HTTPS và xóa domain này.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator trỏ vào máy host qua 10.0.2.2 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- LAN test: điện thoại thật + backend cùng Wi-Fi -->
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.1.0</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

